fastlane_version "2.228.0"

default_platform(:ios)

require "fileutils"

IOS_ROOT = File.expand_path("..", __dir__)
FASTLANE_ROOT = File.expand_path(__dir__)
PROJECT_SPEC_PATH = File.join(IOS_ROOT, "project.yml")
XCODEPROJ_PATH = File.join(IOS_ROOT, "AppTemplate.xcodeproj")
ARTIFACTS_DIR = File.join(IOS_ROOT, "artifacts", "appstore")
APP_STORE_EXPORTS_DIR = File.join(IOS_ROOT, "outputs", "appstore-exports")
FASTLANE_SCREENSHOTS_DIR = File.join(FASTLANE_ROOT, "screenshots")
FASTLANE_ENV_PATH = File.join(FASTLANE_ROOT, ".env")
DEFAULT_SCHEME = "AppTemplate"
DEFAULT_BUNDLE_ID = "com.boogios.template"
DEFAULT_DISPLAY_NAME = "AppTemplate"
DEFAULT_PRIMARY_CATEGORY = "Utilities"
DEFAULT_SUPPORT_URL = "https://example.com/support"
DEFAULT_MARKETING_URL = "https://example.com"
DEFAULT_PRIVACY_URL = "https://example.com/AppTemplate/privacy"
DEFAULT_TERMS_URL = "https://example.com/AppTemplate/terms"

def read_project_spec_value(key)
  spec = File.read(PROJECT_SPEC_PATH)
  match = spec.match(/^\s*#{Regexp.escape(key)}:\s+("?)([^"\n]+)\1$/)
  UI.user_error!("Could not find #{key} in #{PROJECT_SPEC_PATH}") unless match

  match[2].strip
end

def update_project_spec_versions!(marketing_version:, build_number:)
  spec = File.read(PROJECT_SPEC_PATH)
  updated = spec.sub(/^(\s*MARKETING_VERSION:\s+).+$/, "\\1#{marketing_version}")
  updated = updated.sub(/^(\s*CURRENT_PROJECT_VERSION:\s+).+$/, "\\1#{build_number}")
  File.write(PROJECT_SPEC_PATH, updated) if updated != spec
end

def generate_xcode_project!
  UI.user_error!("xcodegen is required but was not found in PATH") unless system("which xcodegen >/dev/null 2>&1")

  Dir.chdir(IOS_ROOT) do
    sh("xcodegen generate")
  end
end

def default_build_number
  Time.now.strftime("%Y%m%d%H%M")
end

def default_locale
  locale = ENV["APP_STORE_LOCALE"].to_s.strip
  locale.empty? ? "en-US" : locale
end

def fallback_locale
  locale = ENV["APP_STORE_FALLBACK_LOCALE"].to_s.strip
  locale.empty? ? "ko" : locale
end

def configured_app_store_locales
  raw_locales = raw_env_value("APP_STORE_LOCALES").to_s.strip
  raw_locales = ENV["APP_STORE_LOCALES"].to_s.strip if raw_locales.empty?
  return [] if raw_locales.empty?

  raw_locales.split(",").map(&:strip).reject(&:empty?).uniq
end

def metadata_locales
  configured_locales = configured_app_store_locales
  return configured_locales unless configured_locales.empty?

  legacy_locale_keys = [
    raw_env_value("APP_STORE_LOCALE"),
    raw_env_value("APP_STORE_FALLBACK_LOCALE"),
    ENV["APP_STORE_LOCALE"],
    ENV["APP_STORE_FALLBACK_LOCALE"]
  ].compact.map(&:strip).reject(&:empty?)

  return [default_locale, fallback_locale].uniq unless legacy_locale_keys.empty?

  ["en-US", "en-GB", "en-CA", "en-AU", "ko", "ja", "de-DE", "fr-FR", "pt-BR", "vi"]
end

def raw_env_value(key)
  return nil unless File.exist?(FASTLANE_ENV_PATH)

  prefix = "#{key}="
  line = File.readlines(FASTLANE_ENV_PATH, chomp: true).find { |entry| entry.start_with?(prefix) }
  return nil unless line

  line.delete_prefix(prefix)
end

def decode_metadata_value(value)
  value
    .gsub("\\r\\n", "\n")
    .gsub("\\n", "\n")
    .gsub("\\t", "\t")
    .gsub('\\"', '"')
    .gsub("\\\\", "\\")
end

def metadata_value(key, fallback)
  raw_value = raw_env_value(key).to_s.strip
  return decode_metadata_value(raw_value) unless raw_value.empty?

  env_value = ENV[key].to_s.strip
  return fallback if env_value.empty?

  decode_metadata_value(env_value)
end

def description_with_terms_url(description)
  terms_url = metadata_value("SERVICE_TERMS_URL", DEFAULT_TERMS_URL)
  return description if terms_url.to_s.strip.empty?
  return description if description.include?(terms_url)

  "#{description}\n\nTerms of Use: #{terms_url}"
end

def load_asc_api_key
  key_id = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
  key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]
  key_filepath = ENV["APP_STORE_CONNECT_API_KEY_PATH"]

  if key_content && !key_content.empty?
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      in_house: false
    )
  else
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_filepath,
      in_house: false
    )
  end
end

def ensure_common_inputs!
  UI.user_error!("project.yml not found at #{PROJECT_SPEC_PATH}") unless File.exist?(PROJECT_SPEC_PATH)
  UI.user_error!("fastlane/.env not found. Copy fastlane/.env.example to fastlane/.env and fill app-specific values.") unless File.exist?(FASTLANE_ENV_PATH)

  key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"].to_s.strip
  key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"].to_s.strip
  UI.user_error!("Set APP_STORE_CONNECT_API_KEY_PATH or APP_STORE_CONNECT_API_KEY_CONTENT in fastlane/.env") if key_content.empty? && key_path.empty?
  UI.user_error!("App Store Connect .p8 key not found at #{key_path}") if key_content.empty? && !File.exist?(key_path)

  required_keys = [
    "APP_STORE_APP_ID",
    "APP_STORE_NAME",
    "APP_STORE_PRIMARY_CATEGORY",
    "APP_STORE_PRIVACY_URL",
    "SERVICE_TERMS_URL",
    "APP_STORE_SUBTITLE",
    "APP_STORE_DESCRIPTION",
    "APP_STORE_KEYWORDS",
    "APP_STORE_REVIEW_NOTES",
    "TESTFLIGHT_FEEDBACK_EMAIL"
  ]
  missing_keys = required_keys.select { |key| metadata_value(key, "").to_s.strip.empty? }
  UI.user_error!("Missing required fastlane/.env values: #{missing_keys.join(', ')}") unless missing_keys.empty?
end

def ensure_app_store_version!(bundle_id:, version_string:)
  app = Spaceship::ConnectAPI::App.find(bundle_id)
  UI.user_error!("Could not find App Store Connect app for bundle id '#{bundle_id}'") unless app

  existing_version = app.get_app_store_versions(
    filter: { versionString: version_string, platform: "IOS" }
  ).first

  return existing_version if existing_version

  app.ensure_version!(version_string, platform: "IOS")
  app.get_app_store_versions(
    filter: { versionString: version_string, platform: "IOS" }
  ).first
end

def ensure_app_store_version_localization!(app_store_version:, locale:, attributes:)
  localization = app_store_version.get_app_store_version_localizations(
    filter: { locale: locale }
  ).first

  if localization
    localization.update(attributes: attributes)
  else
    UI.important("Skipping app store version localization creation for #{locale} because fastlane may send invalid create attributes for appStoreVersionLocalizations.")
  end
end

def ensure_app_info_localization!(bundle_id:, locale:, attributes:)
  app = Spaceship::ConnectAPI::App.find(bundle_id)
  UI.user_error!("Could not find App Store Connect app for bundle id '#{bundle_id}'") unless app

  app_info = app.fetch_edit_app_info || app.fetch_latest_app_info
  UI.user_error!("Could not find editable App Store Connect app info for bundle id '#{bundle_id}'") unless app_info

  localization = app_info.get_app_info_localizations(
    filter: { locale: locale }
  ).first

  if localization
    begin
      localization.update(attributes: attributes)
    rescue => error
      UI.important("Skipping app info localization update for #{locale}: #{error.message}")
    end
  else
    UI.important("Skipping app info localization creation for #{locale} because fastlane may send an invalid create payload for appInfoLocalizations.")
  end
end

def app_has_live_version?(bundle_id:)
  app = Spaceship::ConnectAPI::App.find(bundle_id)
  UI.user_error!("Could not find App Store Connect app for bundle id '#{bundle_id}'") unless app

  !app.get_live_app_store_version(platform: "IOS").nil?
end

def ensure_beta_app_localizations!(bundle_id:, beta_description:, feedback_email:, privacy_url:, marketing_url:)
  app = Spaceship::ConnectAPI::App.find(bundle_id)
  UI.user_error!("Could not find App Store Connect app for bundle id '#{bundle_id}'") unless app

  attributes = {
    feedbackEmail: feedback_email,
    description: beta_description,
    privacyPolicyUrl: privacy_url,
    marketingUrl: marketing_url
  }

  existing_localizations = app.get_beta_app_localizations

  metadata_locales.each do |locale|
    localization = existing_localizations.find { |entry| entry.locale.to_s == locale }

    if localization
      Spaceship::ConnectAPI.patch_beta_app_localizations(
        localization_id: localization.id,
        attributes: attributes
      )
    else
      Spaceship::ConnectAPI.post_beta_app_localizations(
        app_id: app.id,
        attributes: attributes.merge(locale: locale)
      )
    end
  end
end

def sync_app_store_screenshots!
  flat_source_files = Dir[File.join(APP_STORE_EXPORTS_DIR, "*.png")].sort
  localized_source_files = metadata_locales.flat_map do |locale|
    Dir[File.join(APP_STORE_EXPORTS_DIR, locale, "*.png")]
  end.sort

  if flat_source_files.empty? && localized_source_files.empty?
    UI.user_error!("No exported App Store screenshots found in #{APP_STORE_EXPORTS_DIR}")
  end

  metadata_locales.each do |locale|
    locale_dir = File.join(FASTLANE_SCREENSHOTS_DIR, locale)
    source_files = Dir[File.join(APP_STORE_EXPORTS_DIR, locale, "*.png")].sort
    source_files = flat_source_files if source_files.empty?
    UI.user_error!("No exported App Store screenshots found for locale #{locale}") if source_files.empty?

    FileUtils.mkdir_p(locale_dir)
    Dir[File.join(locale_dir, "*.png")].each { |path| FileUtils.rm_f(path) }

    source_files.each_with_index do |source_path, index|
      base_name = format("%02d_apptemplate_app_store_%s.png", index + 1, File.basename(source_path, ".png"))
      target_path = File.join(locale_dir, base_name)
      FileUtils.cp(source_path, target_path)
    end
  end
end

def generate_app_store_screenshots!
  UI.user_error!("npm is required but was not found in PATH") unless system("which npm >/dev/null 2>&1")
  UI.user_error!("package.json is missing at #{IOS_ROOT}") unless File.exist?(File.join(IOS_ROOT, "package.json"))

  Dir.chdir(IOS_ROOT) do
    sh("npm run screenshots:export")
  end
end

platform :ios do
  desc "Verify local Fastlane, XcodeGen, signing, and shared ASC key inputs"
  lane :bootstrap_check do
    ensure_common_inputs!
    UI.success("Fastlane bootstrap inputs are present for #{DEFAULT_SCHEME}.")
  end

  desc "Build a Release ipa for TestFlight/App Store"
  lane :build_release do |options|
    marketing_version = options[:version] || read_project_spec_value("MARKETING_VERSION")
    build_number = options[:build_number] || default_build_number

    update_project_spec_versions!(
      marketing_version: marketing_version,
      build_number: build_number
    )
    generate_xcode_project!

    build_app(
      project: XCODEPROJ_PATH,
      scheme: DEFAULT_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: ARTIFACTS_DIR,
      output_name: "AppTemplate-#{marketing_version}-#{build_number}.ipa",
      xcargs: "-allowProvisioningUpdates"
    )
  end

  desc "Upload a Release build to TestFlight"
  lane :beta do |options|
    ensure_common_inputs!
    api_key = load_asc_api_key
    marketing_version = options[:version] || read_project_spec_value("MARKETING_VERSION")
    build_number = options[:build_number] || default_build_number

    build_release(
      version: marketing_version,
      build_number: build_number
    )

    feedback_email = metadata_value("TESTFLIGHT_FEEDBACK_EMAIL", "your-email@example.com")
    beta_description = metadata_value("TESTFLIGHT_BETA_DESCRIPTION", "AppTemplate beta build for testing the main app flow and settings screen.")
    privacy_url = metadata_value("APP_STORE_PRIVACY_URL", DEFAULT_PRIVACY_URL)
    marketing_url = metadata_value("APP_STORE_MARKETING_URL", DEFAULT_MARKETING_URL)
    what_to_test = metadata_value("TESTFLIGHT_WHAT_TO_TEST", "Please test the home screen, settings screen, language switching, theme switching, and core app flow.")
    review_notes = metadata_value("TESTFLIGHT_REVIEW_NOTES", "No demo account is required unless this app adds login-gated features.")
    contact_first_name = metadata_value("TESTFLIGHT_CONTACT_FIRST_NAME", "Your")
    contact_last_name = metadata_value("TESTFLIGHT_CONTACT_LAST_NAME", "Name")
    contact_phone = metadata_value("TESTFLIGHT_CONTACT_PHONE", "+00 0000000000")

    ensure_app_store_version!(
      bundle_id: DEFAULT_BUNDLE_ID,
      version_string: marketing_version
    )

    ensure_beta_app_localizations!(
      bundle_id: DEFAULT_BUNDLE_ID,
      beta_description: beta_description,
      feedback_email: feedback_email,
      privacy_url: privacy_url,
      marketing_url: marketing_url
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: DEFAULT_BUNDLE_ID,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      changelog: what_to_test,
      beta_app_description: beta_description,
      beta_app_feedback_email: feedback_email,
      beta_app_review_info: {
        contact_email: feedback_email,
        contact_first_name: contact_first_name,
        contact_last_name: contact_last_name,
        contact_phone: contact_phone,
        demo_account_required: false,
        notes: review_notes
      },
      groups: [options[:group] || ENV.fetch("TESTFLIGHT_EXTERNAL_GROUP", "Public Beta")],
      distribute_external: true,
      notify_external_testers: options.fetch(:notify_external_testers, true),
      skip_waiting_for_build_processing: false,
      uses_non_exempt_encryption: false
    )
  end

  desc "Prepare App Store Connect metadata without submitting for review"
  lane :prepare_app_review_metadata do |options|
    ensure_common_inputs!
    load_asc_api_key

    version_string = options[:version] || read_project_spec_value("MARKETING_VERSION")
    app_store_version = ensure_app_store_version!(
      bundle_id: DEFAULT_BUNDLE_ID,
      version_string: version_string
    )

    subtitle = metadata_value("APP_STORE_SUBTITLE", "Boogios starter app")
    app_name = metadata_value("APP_STORE_NAME", DEFAULT_DISPLAY_NAME)
    promo_text = metadata_value("APP_STORE_PROMOTIONAL_TEXT", "Boogios starter app promotional text.")
    description = description_with_terms_url(
      metadata_value("APP_STORE_DESCRIPTION", "AppTemplate is a Boogios starter app. Replace this description with app-specific App Store copy before release.")
    )
    keywords = metadata_value("APP_STORE_KEYWORDS", "boogios,starter,template")
    whats_new = metadata_value("APP_STORE_WHATS_NEW", "Improved stability and usability.")
    marketing_url = metadata_value("APP_STORE_MARKETING_URL", DEFAULT_MARKETING_URL)
    support_url = metadata_value("APP_STORE_SUPPORT_URL", DEFAULT_SUPPORT_URL)
    privacy_url = metadata_value("APP_STORE_PRIVACY_URL", DEFAULT_PRIVACY_URL)
    copyright = metadata_value("APP_STORE_COPYRIGHT", "2026 BOOGIOS_STUDIO")
    review_notes = metadata_value("APP_STORE_REVIEW_NOTES", "Please review the main app flow and settings screen.")
    contact_email = metadata_value("TESTFLIGHT_FEEDBACK_EMAIL", "your-email@example.com")
    contact_phone = metadata_value("TESTFLIGHT_CONTACT_PHONE", "+00 0000000000")
    contact_first_name = metadata_value("TESTFLIGHT_CONTACT_FIRST_NAME", "Your")
    contact_last_name = metadata_value("TESTFLIGHT_CONTACT_LAST_NAME", "Name")

    version_localization_attributes = {
      promotionalText: promo_text,
      description: description,
      keywords: keywords,
      marketingUrl: marketing_url,
      supportUrl: support_url
    }

    if app_has_live_version?(bundle_id: DEFAULT_BUNDLE_ID)
      version_localization_attributes[:whatsNew] = whats_new
    else
      UI.important("Skipping 'What's New' for #{version_string} because there is no live App Store version yet.")
    end

    metadata_locales.each do |locale|
      ensure_app_info_localization!(
        bundle_id: DEFAULT_BUNDLE_ID,
        locale: locale,
        attributes: {
          name: app_name,
          subtitle: subtitle,
          privacyPolicyUrl: privacy_url
        }
      )

      ensure_app_store_version_localization!(
        app_store_version: app_store_version,
        locale: locale,
        attributes: version_localization_attributes
      )
    end

    app_store_version.update(attributes: { copyright: copyright })

    review_detail = begin
      app_store_version.fetch_app_store_review_detail
    rescue
      nil
    end

    review_attributes = {
      contact_first_name: contact_first_name,
      contact_last_name: contact_last_name,
      contact_phone: contact_phone,
      contact_email: contact_email,
      demo_account_required: false,
      notes: review_notes
    }

    if review_detail
      review_detail.update(attributes: review_attributes)
    else
      app_store_version.create_app_store_review_detail(attributes: review_attributes)
    end
  end

  desc "Sync exported App Store screenshots into fastlane deliver folders"
  lane :sync_app_store_screenshots do
    sync_app_store_screenshots!
    UI.success("Synced App Store screenshots to #{FASTLANE_SCREENSHOTS_DIR}")
  end

  desc "Generate localized App Store screenshots from AppStoreScreenshots config"
  lane :generate_app_store_screenshots do
    generate_app_store_screenshots!
    UI.success("Generated App Store screenshots in #{APP_STORE_EXPORTS_DIR}")
  end

  desc "Build, sync metadata, and submit a version for App Store review"
  lane :release do |options|
    ensure_common_inputs!
    api_key = load_asc_api_key
    marketing_version = options[:version] || read_project_spec_value("MARKETING_VERSION")
    build_number = options[:build_number] || default_build_number
    skip_binary_upload = ENV["RELEASE_SKIP_BINARY_UPLOAD"] == "true"
    submit_for_review = ENV["RELEASE_SUBMIT_FOR_REVIEW"] != "false"
    primary_category = metadata_value("APP_STORE_PRIMARY_CATEGORY", DEFAULT_PRIMARY_CATEGORY)

    unless skip_binary_upload
      build_release(
        version: marketing_version,
        build_number: build_number
      )
    end

    prepare_app_review_metadata(version: marketing_version)
    sync_app_store_screenshots! unless ENV["RELEASE_SKIP_SCREENSHOTS"] == "true"

    deliver(
      api_key: api_key,
      ipa: skip_binary_upload ? nil : lane_context[SharedValues::IPA_OUTPUT_PATH],
      build_number: skip_binary_upload ? ENV["RELEASE_BUILD_NUMBER"] : nil,
      app_identifier: DEFAULT_BUNDLE_ID,
      submission_information: {
        export_compliance_uses_encryption: false
      },
      submit_for_review: submit_for_review,
      automatic_release: ENV["AUTOMATIC_RELEASE"] != "false",
      skip_binary_upload: skip_binary_upload,
      skip_metadata: true,
      skip_screenshots: ENV["RELEASE_SKIP_SCREENSHOTS"] == "true",
      screenshots_path: FASTLANE_SCREENSHOTS_DIR,
      overwrite_screenshots: true,
      primary_category: primary_category,
      force: true,
      run_precheck_before_submit: false
    )
  end
end
